# GENERADO por Ansible (rol dev_vm) — NO editar a mano.
# Entorno de las VMs de desarrollo (flujo develop -> Compute Engine).

DOCKERHUB_USERNAME={{ dockerhub_username }}

# IP interna de la VM de Base de Datos (persistencia aislada).
DB_VM_HOST={{ db_internal_ip | default('10.10.0.10') }}
DATABASE_VM_IP={{ db_internal_ip | default('10.10.0.10') }}

# --- Bases de datos ---
AUTH_DB_NAME={{ auth_db_name }}
AUTH_DB_USER={{ auth_db_user }}
AUTH_DB_PASSWORD={{ vault_auth_db_password }}
SUBSCRIPTION_DB_NAME={{ subscription_db_name }}
SUBSCRIPTION_DB_USER={{ subscription_db_user }}
SUBSCRIPTION_DB_PASSWORD={{ vault_subscription_db_password }}
CATALOG_DB_NAME={{ catalog_db_name }}
CATALOG_DB_USER={{ catalog_db_user }}
CATALOG_DB_PASSWORD={{ vault_catalog_db_password }}
RATING_DB_NAME={{ rating_db_name }}
RATING_DB_USER={{ rating_db_user }}
RATING_DB_PASSWORD={{ vault_rating_db_password }}
FX_DB_NAME={{ fx_db_name }}
FX_DB_USER={{ fx_db_user }}
FX_DB_PASSWORD={{ vault_fx_db_password }}
HISTORY_DB_NAME={{ history_db_name }}
HISTORY_DB_USER={{ history_db_user }}
HISTORY_DB_PASSWORD={{ vault_history_db_password }}
NOTIFICATION_DB_NAME={{ notification_db_name }}
NOTIFICATION_DB_USER={{ notification_db_user }}
NOTIFICATION_DB_PASSWORD={{ vault_notification_db_password }}

REDIS_PASSWORD={{ vault_redis_password }}

# --- Direcciones gRPC entre servicios ---
AUTH_SERVICE_ADDR={{ auth_service_addr }}
BILLING_SERVICE_ADDR={{ billing_service_addr }}
FX_SERVICE_ADDR={{ fx_service_addr }}
NOTIFICATION_SERVICE_ADDR={{ notification_service_addr }}
CATALOG_SERVICE_ADDR={{ catalog_service_addr }}
RATING_SERVICE_ADDR={{ rating_service_addr }}
HISTORY_SERVICE_ADDR={{ history_service_addr }}
CATALOG_ADMIN_HTTP_ADDR={{ catalog_admin_http_addr }}
CORS_ORIGIN={{ cors_origin }}

# --- App / JWT ---
JWT_SECRET={{ vault_jwt_secret | default('CHANGE_ME') }}
JWT_TTL_MIN={{ jwt_ttl_min | default('60') }}

# --- SMTP ---
SMTP_HOST={{ vault_smtp_host | default('') }}
SMTP_PORT={{ smtp_port | default('587') }}
SMTP_SECURE={{ smtp_secure | default('false') }}
SMTP_USER={{ vault_smtp_user | default('') }}
SMTP_PASS={{ vault_smtp_pass | default('') }}
SMTP_FROM={{ vault_smtp_from | default('') }}

# --- GCS ---
GCS_BUCKET_NAME={{ gcs_bucket_name | default('quetxal-tv-media-bucket') }}
GCS_ACCESS_KEY={{ vault_gcs_access_key | default('') }}
GCS_SECRET_KEY={{ vault_gcs_secret_key | default('') }}
