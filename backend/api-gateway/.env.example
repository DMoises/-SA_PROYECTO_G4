# =====================================================================
# api-gateway | .env.example  (copia a .env; NO subir .env)
# =====================================================================

# Puerto HTTP que expone el gateway (unico punto de entrada del sistema)
GATEWAY_PORT=8080

# Direccion gRPC del auth-service.
#  - En Docker (misma red):      auth-service:50051
#  - En local con 'go run':      localhost:50051
AUTH_SERVICE_ADDR=auth-service:50051

# Cookies: false en local (HTTP), true en produccion (HTTPS)
COOKIE_SECURE=false

# Origen del frontend permitido por CORS
CORS_ORIGIN=http://localhost:3000
