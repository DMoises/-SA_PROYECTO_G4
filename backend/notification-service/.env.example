# =====================================================================
# notification-service | .env.example  (copia a .env; NO subir .env)
# =====================================================================

# Servidor gRPC
GRPC_URL=0.0.0.0:50054

# Conexion a notification_db
NOTIFICATION_DB_HOST=notification-db
NOTIFICATION_DB_PORT_INTERNAL=5432
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=cambia_esta_clave

# SMTP para enviar correos.
# Para PRUEBAS se recomienda Mailtrap (https://mailtrap.io) o Ethereal:
# son SMTP de sandbox que capturan el correo sin enviarlo de verdad.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_usuario_smtp
SMTP_PASS=tu_password_smtp
SMTP_FROM=Quetxal TV <no-reply@quetxal.tv>
