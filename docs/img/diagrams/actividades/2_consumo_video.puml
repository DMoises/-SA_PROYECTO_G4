@startuml Diagrama_Actividades_Consumo_Video
title Diagrama de Actividades - Autenticación JWT, Validación y Consumo de Video (Streaming)

skinparam activity {
    BackgroundColor #E3F2FD
    BorderColor #1565C0
    ArrowColor #0D47A1
}
skinparam swimlane {
    BorderColor #9E9E9E
    BorderThickness 2
    TitleFontColor #1565C0
}

|Cliente (Frontend)|
start
:Selecciona un perfil de usuario;
:Busca contenido (Película o Serie);
:Presiona "Reproducir";
:Envía solicitud de streaming con JWT;

|API Gateway|
:Intercepta petición y valida firma de JWT;
if (¿Token es válido?) then (No)
  :Retorna HTTP 401 Unauthorized;
  |Cliente (Frontend)|
  :Redirecciona a login;
  end
else (Sí)
  :Verifica Claims del JWT (Suscripción 'Activa');
  if (¿Suscripción Activa?) then (No)
    :Retorna HTTP 403 Forbidden;
    |Cliente (Frontend)|
    :Muestra modal "Mejora tu plan para ver este contenido";
    end
  else (Sí)
    :Enruta a Content/Streaming Service vía gRPC;
  endif
endif

|Streaming Service|
:Consulta metadatos del video y URL del CDN;

|Content DB / Cache (Redis)|
:Retorna metadatos y progreso anterior (si existe);

|Streaming Service|
:Retorna metadatos, URL de streaming y timestamp al cliente;

|API Gateway|
:Envía respuesta al Frontend;

|Cliente (Frontend)|
:Inicializa reproductor de video con URL del CDN;
:Comienza la reproducción desde el timestamp;

fork
    :Reproduce video (Chunks desde CDN);
    :Usuario visualiza el contenido;
    detach
fork again
    repeat
        :Cada 30 segundos:
        Envía pulso (Heartbeat) de progreso con JWT;
        
        |API Gateway|
        :Valida JWT y enruta a Analytics/History Service;
        
        |History Service|
        :Actualiza tiempo reproducido para el perfil actual;
        
        |History DB|
        :Guarda historial de visualización;
    repeat while (¿Sigue viendo el video?) is (Sí)
    ->No;
    |Cliente (Frontend)|
    :Usuario pausa o cierra el video;
    :Envía pulso final de progreso;
    detach
end merge
@enduml
