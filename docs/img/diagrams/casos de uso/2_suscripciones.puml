@startuml
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FFF9C4
  BorderColor #F57F17
  ArrowColor #E65100
}
title CDU Expandido: 2. Gestión de Suscripciones (Nivel CIM)

actor "Usuario Registrado" as registrado
actor "Usuario Suscriptor" as suscriptor

package "Módulo 2: Suscripciones" {
  usecase "CDU-N2-01: Adquirir Plan de Suscripción" as adquirir
  usecase "CDU-N2-02: Procesar Cobro Recurrente" as cobrar
  usecase "CDU-N2-03: Actualizar Plan de Suscripción" as descuento
  usecase "CDU-N2-04: Cancelar Suscripción Activa" as cancelar
}

registrado --> adquirir
suscriptor --> descuento
suscriptor --> cobrar
suscriptor --> cancelar

adquirir ..> cobrar : <<include>>
descuento ..> adquirir : <<extend>>

@enduml
