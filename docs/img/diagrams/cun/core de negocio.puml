@startuml
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor #E1F5FE
    BorderColor #0277BD
    ArrowColor #01579B
}

title Modelo de Casos de Uso: Core del Negocio (Quetxal TV)

actor "Usuario Suscriptor" as user
actor "API de Divisas (FX)\n<<Sistema Externo>>" as fx
actor "Servicio SMTP\n<<Sistema Externo>>" as smtp

rectangle "Ecosistema Quetxal TV" {
  usecase "Proveer Streaming de Video Bajo Demanda\n(Suscripción y Catálogo)" as core
}

user --> core : "Consume contenido y gestiona cuenta"
core --> fx : "Consulta tipos de cambio"
core --> smtp : "Delega notificaciones"

@enduml