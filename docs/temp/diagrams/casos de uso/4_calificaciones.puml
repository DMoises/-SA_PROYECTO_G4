@startuml
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FFF3E0
  BorderColor #E65100
  ArrowColor #E65100
}

title CDU Expandido: 4. Sistema de Calificaciones (Nivel CIM)

actor "Usuario Suscriptor" as user

package "Módulo 4: Calificaciones de Comunidad" {
  usecase "CDU-N4-01: Emitir Valoración" as valorar
  usecase "CDU-N4-02: Modificar Valoración Previa" as modificar
  usecase "CDU-N4-03: Consultar % Global de Recomendación" as visualizar
}

user --> valorar
user --> visualizar
modificar ..> valorar : <<extend>>

@enduml