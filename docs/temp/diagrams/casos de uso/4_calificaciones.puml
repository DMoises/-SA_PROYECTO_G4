@startuml
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FFF3E0
  BorderColor #E65100
  ArrowColor #E65100
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #E65100
}

title CDU Expandido: 4. Sistema de Calificaciones (Nivel CIM)

actor "Usuario Suscriptor" as suscriptor
actor "Administrador" as admin

package "Módulo 4: Calificaciones de Comunidad" {
  ' Base alineada con rating-service (Calificar / ObtenerRecomendacion / ObtenerCalificacionUsuario)
  usecase "CDU-N4-01: Emitir/Actualizar Calificación\n(estrella 1-5 o pulgar)" as calificar
  usecase "CDU-N4-02: Consultar % de Recomendación" as recomendacion
  usecase "CDU-N4-03: Consultar mi Calificación actual" as miCalif
  ' Fase 2
  usecase "CDU-N4-04: Registrar en Bitácora\nde Auditoría <<trigger>>" as auditar
  usecase "CDU-N4-05: Generar Reporte de\nCalificaciones (.csv / PDF)" as reporte
}

suscriptor --> calificar
suscriptor --> recomendacion
suscriptor --> miCalif
admin --> reporte

calificar ..> recomendacion : <<include>>
calificar ..> auditar : <<include>>

@enduml
