@startuml
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #E1F5FE
  BorderColor #0277BD
  ArrowColor #01579B
}
title CDU Expandido: 5. Servicio Financiero FX (Nivel CIM)

actor "Usuario Registrado" as registrado
actor "Usuario Suscriptor" as suscriptor
actor "API de Divisas (FX)\n<<Sistema Externo>>" as fx

package "Módulo 5: Servicio FX" {
  usecase "CDU-N5-01: Calcular Tarifa en Moneda Local" as calcular
  usecase "CDU-N5-02: Consultar Tasa de Cambio Actual" as consultar
}

registrado --> calcular
suscriptor --> calcular
calcular ..> consultar : <<include>>
consultar --> fx
@enduml
