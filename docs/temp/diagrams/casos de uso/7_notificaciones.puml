@startuml
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  ArrowColor #0D47A1
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1565C0
}
title CDU Expandido: 7. Notificaciones por Correo (Nivel CIM)

actor "Servicios Internos\n(Auth / Billing / Catálogo)\n<<Sistema>>" as servicios
actor "Administrador" as admin
actor "Worker Outbox\n<<Sistema>>" as worker
actor "Servidor SMTP\n<<Sistema Externo>>" as smtp

package "Módulo 7: Alertas y Comunicación" {
  ' Base alineada con notification-service (EncolarCorreo + worker Outbox -> SMTP)
  usecase "CDU-N7-01: Encolar Notificación\n(registro / recibo / nuevo_contenido)" as encolar
  usecase "CDU-N7-02: Servir Correo Electrónico\n(worker Outbox c/10s)" as servir
  ' Fase 2
  usecase "CDU-N7-03: Programar/Calendarizar Estreno" as estreno
}

servicios --> encolar
admin --> estreno
worker --> servir
servir --> smtp
estreno ..> encolar : <<trigger>> (nuevo_contenido)

@enduml
