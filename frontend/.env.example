# =====================================================================
# frontend | .env.example  (copia a .env.local; NO subir .env.local)
# =====================================================================

# API Gateway (catalogo se consume por aqui, patron BFF: app/api/catalog/* -> gateway)
GATEWAY_URL=http://localhost:8080

# gRPC directo al auth-service (lo usa lib/grpc/auth-client en las rutas de auth)
GRPC_AUTH_URL=localhost:50051
